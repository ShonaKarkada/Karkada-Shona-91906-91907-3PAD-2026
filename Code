    if percentage == 100:
        feedback = "Amazing work! Perfect score!"

    elif percentage >= 80:
        feedback = "Great work! You're ready for the next level."
    elif percentage >= 60:
        feedback = "Good effort! Keep going."

    elif percentage >= 40:
        feedback = "You're getting there. Try again."
    elif percentage == 0:
        feedback = "Oops! Try Again"
    else:
        feedback = "Keep practising. You'll get there!" 

    Label(results, text=feedback, font=(FONT, 10), bg=BACKGROUND,wraplength=300).pack(pady=10)

    def next_level():
        current_student.score = 0

        current_student.current_question = 0

        if combo_difficulty.get() == "BASIC":
            combo_difficulty.set("ADVANCED")

        elif combo_difficulty.get() == "ADVANCED":
