#Create the Student Class, to store student information and add to the score
class Student:

    def __init__(self, username, age, year_level):
        self.username = username
        self.age = age
        self.year_level = year_level
        self.score = 0
        self.level = 1

        self.current_question = 0
        self.quiz_questions = []
#Create an object that adds a point to the overall score when a correct answer is entered
    def add_score(self):
        self.score += 1
    def next_question(self):
        self.current_question += 1


