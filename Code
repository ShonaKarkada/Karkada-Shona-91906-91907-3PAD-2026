from tkinter import *
from tkinter import ttk
import random
import tkinter as tk
from PIL import Image, ImageTk
# Functions

def quit_app():
    main_window.destroy()

def save_selection():
    selected_difficulty = combo_difficulty.get()
    selected_questions = radio_var.get()

    print("Difficulty:", selected_difficulty)
    print("Questions:", selected_questions)

# Main Window

main_window = Tk()
main_window.geometry("800x500")
main_window.configure(background="#dfd5ed")
main_window.title("Math Quiz App")


# Number of Questions

radio_var = tk.StringVar(value="5")

radio_label = tk.Label(
    main_window,
    text="No. Of Questions:",
    font=("Georgia", 10),
    bg="#dfd5ed"
)
radio_label.grid(row=0, column=0, padx=10, pady=10)

radio1 = tk.Radiobutton(
    main_window,
    text="5",
    variable=radio_var,
    value="5",
    bg="#dfd5ed",
    font=("Georgia", 10)
)
radio1.grid(row=0, column=1)

radio2 = tk.Radiobutton(
    main_window,
    text="10",
    variable=radio_var,
    value="10",
    bg="#dfd5ed",
    font=("Georgia", 10)
)
radio2.grid(row=0, column=2)

radio3 = tk.Radiobutton(
    main_window,
    text="15",
    variable=radio_var,
    value="15",
    bg="#dfd5ed",
    font=("Georgia", 10)
)
radio3.grid(row=0, column=3)

# Difficulty Combobox

difficulty_levels = ["Basic", "Advanced", "Expert"]

difficulty_label = tk.Label(
    main_window,
    text="Difficulty:",
    font=("Georgia", 10),
    fg="#3d354a",
    bg="#dfd5ed"
)
difficulty_label.grid(row=1, column=0, padx=10, pady=10)

combo_difficulty = ttk.Combobox(
    main_window,
    values=difficulty_levels,
    width=15
)
combo_difficulty.grid(row=1, column=1, padx=10)
combo_difficulty.current(0)

# Save Button

save_button = tk.Button(
    main_window,
    text="Save Selection",
    command=save_selection
)
save_button.grid(row=2, column=0, columnspan=2, pady=20)

# Quit Button

quit_button = tk.Button(
    main_window,
    text="Quit",
    command=quit_app
)
quit_button.grid(row=2, column=2, columnspan=2, pady=20)

main_window.mainloop()
