#Define the function to be carried out when the finish button is pressed
def save_highscore(student):
    with open(HIGHSCORE_FILE, "a") as file:
        file.write(f"{student.username},{student.score}\n")
        
#Define the view_highscores button on the main window
def view_highscores():
    highscore_window = tk.Toplevel(main_window)
    highscore_window.title("Highscores Window")
    highscore_window.geometry("312x320")
    highscore_window.configure(bg=BACKGROUND)

    Label(highscore_window, text="   HIGHSCORES   ", font=(FONT, 10),bg=HEADER ).grid(row=0, column=1, columnspan=3, pady=10)

#Prompt the program to retrieve the required information from the text file
    try:
        scores = []

        with open(HIGHSCORE_FILE, "r") as file:

            for line in file:
                line = line.strip()

                if line != "":
                    username, score = line.split(",")
                    scores.append((username, int(score)))

        scores.sort(key=lambda x: x[1], reverse=True)

        if len(scores) > 0:
            #Create the table layout
            Label(highscore_window, text="RANK", width=10, borderwidth=0.5,  relief="solid", bg=HEADER, font=(FONT, 8,)).grid(row=1, column=1, padx=3,)

            Label(highscore_window, text="USERNAME", width=20, borderwidth=0.5, relief="solid", bg=HEADER, font=(FONT, 8,) ).grid(row=1, column=2, padx=3,  )

            Label(highscore_window, text="SCORE", width=10, borderwidth=0.5, relief="solid", bg=HEADER, font=(FONT, 8) ).grid(row=1, column=3, padx=3, )

            #Prompt the program to only display the user's top 5 scores, in order
            for rank, (username, score) in enumerate(scores[:TOP_SCORES], start=1):

                Label(highscore_window, text=rank, bg=BACKGROUND ).grid(row=rank + 1, column=1)

                Label(highscore_window, text=username.capitalize(), bg=BACKGROUND ).grid(row=rank + 1, column=2)

                Label(highscore_window, text=score, bg=BACKGROUND ).grid(row=rank + 1, column=3)

            button_row = 8

        else:
                Label( highscore_window, text="No highscores yet", font=(FONT, 9), bg=BACKGROUND, anchor="center", justify="center").grid(row=2, column=1, columnspan=3, pady=20, sticky="e")

                button_row = 3        

    except FileNotFoundError:
        Label(highscore_window, text="No highscores found.", font=(FONT, 9), bg=BACKGROUND, anchor="center",
    justify="center").grid(row=2, column=1, columnspan=3, pady=20, sticky="ew")

        button_row = 3
    
    Button(highscore_window, text="CLOSE", font=(FONT, 8), command=highscore_window.destroy, width=12).grid(row=button_row, column=1, columnspan=3, pady=20)
        
def start_quiz():
    main_window.withdraw()
#Create the quiz window
    quiz_window = tk.Toplevel(main_window)
    quiz_window.title("Question Screen")
    quiz_window.geometry("600x400")
    quiz_window.configure(bg=BACKGROUND)

#Prompt the program to only select questions based on difficulty and number chosen
    difficulty = combo_difficulty.get()
    number_questions = question_var.get()

    available_questions = []

    for question in questions:
        if question["difficulty"] == difficulty:
            available_questions.append(question)

    random.shuffle(available_questions)

    current_student.quiz_questions = available_questions[:number_questions]
    current_student.current_question = 0

    uppercase_username = current_student.username.upper()

#Student information
    Label( quiz_window, text=f"       STUDENT: {uppercase_username}    AGE: {current_student.age}    YEAR LEVEL: {current_student.year_level}    DIFFICULTY: {difficulty}", font=(FONT, 8), bg=BACKGROUND ).grid(row=1, column=0, columnspan=4, pady=10)


    question_number = Label( quiz_window, text="", font=(FONT, 10), bg=BACKGROUND)
    question_number.grid(row=1, column=4)

#Question label
    question_label = Label( quiz_window, text="", font=(FONT, 14), bg=BACKGROUND )
    question_label.grid(row=2, column=3, sticky = "w", columnspan=4, pady=20)

#Create radiobuttons to allow the user to select an answer from 4 options
    answer_var = StringVar()

    # Radio buttons
    radio1 = Radiobutton(quiz_window, text="", variable=answer_var, value = "1", bg=BACKGROUND)
    radio1.grid(row=3, column=3, sticky="w", padx=40)

    radio2 = Radiobutton(quiz_window, text="", variable=answer_var, value = "2", bg=BACKGROUND)
    radio2.grid(row=4, column=3, sticky="w", padx=40)

    radio3 = Radiobutton(quiz_window, text="", variable=answer_var, value = "3", bg=BACKGROUND)
    radio3.grid(row=5, column=3, sticky="w", padx=40)

    radio4 = Radiobutton(quiz_window, text="", variable=answer_var, value = "4", bg=BACKGROUND)
    radio4.grid(row=6, column=3, sticky="w", padx=40)

#Display current question
    def show_question():

        q = current_student.quiz_questions[current_student.current_question]
        question_number.config( text=f"              Question {current_student.current_question + 1} of {len (current_student.quiz_questions)}" )
        question_label.config(text=q["question"])

        radio1.config(text= q["choices"][0], value = q["choices"][0])
        radio2.config(text =q["choices"][1], value = q["choices"][1])
        radio3.config(text= q["choices"][2], value =q["choices"][2])
        radio4.config(text= q["choices"][3], value = q["choices"][3])

        answer_var.set("NONE")

    # Move to next question
    def next_question():

        if answer_var.get() == "NONE":
            error_window("Please select an answer or press Skip.")
            return

        q = current_student.quiz_questions[current_student.current_question]

        if answer_var.get() == q["answer"]:
            current_student.add_score()

        current_student.next_question()

        if current_student.current_question >= len(current_student.quiz_questions):

            save_highscore(current_student)

            quiz_window.destroy()

            results_window()

            return

        show_question()

    # Next button
    Button(quiz_window, text="NEXT", font=(FONT, 10), width=15, background="#bfb9c7", command=next_question ).grid(row=8, column=3, sticky = "w", pady=30)


    def skip_question():

        current_student.next_question()

        if current_student.current_question >= len(current_student.quiz_questions):
            save_highscore(current_student)
            quiz_window.destroy()
            results_window()
            return

        show_question()
    

    Button( quiz_window, text="SKIP", font=(FONT,10), background="#bfb9c7", width=15, command=skip_question).grid(row=8, column=2, padx=1, pady=30, sticky = "w")

    def quit_question():

        answer = messagebox.askyesno(
            "Quit",
            "Are you sure you want to quit?"
        )

        if answer:
            quiz_window.destroy()
            main_window.deiconify()
        
    

    Button(quiz_window, text="QUIT", font=(FONT,10), background="#bfb9c7", width=15, command=quit_question).grid(row=8, column=4,  sticky = "w", pady=30)



    # Show the first question
    show_question()

def results_window():
    results = tk.Toplevel(main_window)
    results.title("Results")
    results.geometry("350x250")
    results.configure(bg=BACKGROUND)

    Label(results, text=f"Student: {current_student.username.upper()}", bg=BACKGROUND, font=(FONT,10)).pack(pady=5)

    Label(results, text=f"Level: {combo_difficulty.get()}", bg=BACKGROUND, font=(FONT,10)).pack()

    Label(results, text=f"Score: {current_student.score}/{len(current_student.quiz_questions)}", bg=BACKGROUND, font=(FONT,16)).pack(pady=15)
            
    percentage = (current_student.score / len(current_student.quiz_questions)) * 100

    if percentage == 100:
        feedback = "Amazing work! Perfect score!"

    elif percentage >= 80:
        feedback = "Great work! You're ready for the next level."
    elif percentage >= 60:
        feedback = "Good effort! Keep going."

    elif percentage >= 40:
        feedback = "You're getting there. Try again."
    else:
        feedback = "Keep practising. You'll get there!"

    Label(results, text=feedback, font=(FONT, 10), bg=BACKGROUND,wraplength=300).pack(pady=10)

    def next_level():
        current_student.score = 0

        current_student.current_question = 0

        if combo_difficulty.get() == "BASIC":
            combo_difficulty.set("ADVANCED")

        elif combo_difficulty.get() == "ADVANCED":
            combo_difficulty.set("EXPERT")

        else:
            results.destroy()
            main_window.deiconify()
            return

        results.destroy()
        start_quiz()


    Button(results, text="Retry Level", font=(FONT, 10), width=15, bg="#bfb9c7", command=lambda: ( results.destroy(), setattr(current_student, "score", 0), start_quiz())).pack(side="left", padx=20, pady=20)


    def main_menu():
        results.destroy()
        main_window.deiconify()
        



    if combo_difficulty.get() != "EXPERT":
        Button(results, text="Next Level", font=(FONT, 10), width=15, bg="#bfb9c7", command=next_level ).pack(side="right", padx=20, pady=20)

    else:
        Button(results, text="Finish", font=(FONT, 10), width=15, bg="#bfb9c7", command=lambda: ( results.destroy(), main_window.deiconify()) ).pack(side="right", padx=20, pady=20)
    


#Set up validation checks to ensure that the user information is suitable and accurate - display the error window for invalid or boundary cases
def check_inputs():
    username = entry_username.get().strip()
    age = entry_age.get().strip()
    year_level = entry_year_level.get().strip()


#Username Validation check
    if username == "":
        error_window("Username cannot be blank.")
        return

    if not username.replace(" ", "").isalpha():
        error_window("Username must contain letters only.")
        return

#Age Validation
    
    if not age.isdigit():
        error_window("Age must be numeric.")
        return
    age = int(age)
    if age < 0 or age > MAX_AGE:
        error_window("Age must be between 0 and 120.")
        return

#Year Level Validation
    if not year_level.isdigit():
        error_window("Year level must be numeric.")
        return
    year_level = int(year_level)
    if year_level < MIN_YEAR_LEVEL or year_level > MAX_YEAR_LEVEL:
        error_window("Year level must be between 1 and 13.")
        return

#Combo Box Validation check
    if combo_difficulty.get() not in DIFFICULTIES:
        error_window("Please select a difficulty option.")
        return
 

#Create the Student Object for the Student Class
    global current_student
    
    current_student = Student( username, age, year_level )
    start_quiz()

