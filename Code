#Define the error_window to be displayed when an invalid input is entered
def error_window(message):
    error = tk.Toplevel(main_window)
    error.title("Input Error")
    error.geometry("300x120")
    error.configure(bg="#fad7e4")

    Label(error, text=message, fg="red", bg="#fad7e4", font= ("Georgia", 10)).pack(pady=20)

    Button(error, text="OK", command=error.destroy, width=10).pack()

#Define the function to be carried out when the finish button is pressed
def save_highscore(student):
    with open(HIGHSCORE_FILE, "a") as file:
        file.write(f"{student.username},{student.score}\n")

#Define the view_highscores button on the main window
def view_highscores():
    highscore_window = tk.Toplevel(main_window)
    highscore_window.title("Highscores Window")
    highscore_window.geometry("312x320")
    highscore_window.configure(bg="#fad7e4")

    Label(highscore_window, text="   HIGHSCORES   ", font=("Georgia", 10),bg="#cfc1e3" ).grid(row=0, column=1, columnspan=3, pady=10)

#Prompt the program to retrieve the required information from the text file
    try:
        scores = []

        with open(HIGHSCORE_FILE, "r") as file:

            for line in file:
                line = line.strip()

                if line != "":
                    username, score = line.split(",")
                    scores.append((username, int(score)))

        scores.sort(key=lambda x: x[1], reverse=True)
        if len(scores) > 0:
            #Create the table layout
            Label(highscore_window, text="RANK", width=10, borderwidth=0.5,  relief="solid", bg="#cfc1e3", font=("Georgia", 8,)).grid(row=1, column=1, padx=3,)

            Label(highscore_window, text="USERNAME", width=20, borderwidth=0.5, relief="solid", bg="#cfc1e3", font=("Georgia", 8,) ).grid(row=1, column=2, padx=3,  )

            Label(highscore_window, text="SCORE", width=10, borderwidth=0.5, relief="solid", bg="#cfc1e3", font=("Georgia", 8) ).grid(row=1, column=3, padx=3, )

            #Prompt the program to only display the user's top 5 scores, in order
            for rank, (username, score) in enumerate(scores[:5], start=1):

                Label(highscore_window, text=rank, bg="#fad7e4" ).grid(row=rank + 1, column=1)

                Label(highscore_window, text=username.capitalize(), bg="#fad7e4" ).grid(row=rank + 1, column=2)

                Label(highscore_window, text=score, bg="#fad7e4" ).grid(row=rank + 1, column=3)

        else:
                Label( highscore_window, text="No highscores yet", font=("Georgia", 9), bg="#fad7e4").grid(row=7, column=1, pady=10, columnspan=3)

    except FileNotFoundError:
        Label( highscore_window, text="No highscores found.", font=("Georgia", 9), bg="#fad7e4").grid(row=7, column=1, pady=10, columnspan=3)

    Button( highscore_window, text="CLOSE", font=("Georgia", 8), command=highscore_window.destroy,width=12 ).grid(row=8, column=1, columnspan=3, pady=25)
        
def start_quiz():
#Create the quiz window
    quiz_window = tk.Toplevel(main_window)
    quiz_window.title("Question Screen")
    quiz_window.geometry("610x400")
    quiz_window.configure(bg="#fad7e4")

#Prompt the program to only select questions based on difficulty and number chosen
    difficulty = combo_difficulty.get()
    number_questions = int(radio_var.get())

    available_questions = []

    for question in questions:
        if question["difficulty"] == difficulty:
            available_questions.append(question)

    random.shuffle(available_questions)

    current_student.quiz_questions = available_questions[:number_questions]
    current_student.current_question = 0

    uppercase_username = current_student.username.upper()

#Student information
    Label( quiz_window, text=f"STUDENT: {uppercase_username}    AGE: {current_student.age}    YEAR LEVEL: {current_student.year_level}    DIFFICULTY: {difficulty}", font=("Georgia", 8), bg="#fad7e4" ).grid(row=1, column=0, columnspan=4, pady=10)


    question_number = Label( quiz_window, text="", font=("Georgia", 10), bg="#fad7e4")
    question_number.grid(row=1, column=4)

#Question label
    question_label = Label( quiz_window, text="", font=("Georgia", 14), bg="#fad7e4" )
    question_label.grid(row=2, column=0, columnspan=4, pady=20)

#Create radiobuttons to allow the user to select an answer from 4 options
    answer_var = StringVar()

    # Radio buttons
    radio1 = Radiobutton(quiz_window, text="", variable=answer_var, bg="#fad7e4")
    radio1.grid(row=3, column=0, sticky="w", padx=40)

    radio2 = Radiobutton(quiz_window, text="", variable=answer_var, bg="#fad7e4")
    radio2.grid(row=4, column=0, sticky="w", padx=40)

    radio3 = Radiobutton(quiz_window, text="", variable=answer_var, bg="#fad7e4")
    radio3.grid(row=5, column=0, sticky="w", padx=40)

    radio4 = Radiobutton(quiz_window, text="", variable=answer_var, bg="#fad7e4")
    radio4.grid(row=6, column=0, sticky="w", padx=40)

#Display current question
    def show_question():

        q = current_student.quiz_questions[current_student.current_question]
        question_number.config( text=f"Question {current_student.current_question + 1} of {len (current_student.quiz_questions)}" )
        question_label.config(text=q["question"])

        radio1.config(text=q["choices"][0], value = q["choices"][0])
        radio2.config(text=q["choices"][1], value = q["choices"][1])
        radio3.config(text=q["choices"][2], value =q["choices"][2])
        radio4.config(text=q["choices"][3], value = q["choices"][3])

        answer_var.set("")

    # Move to next question
    def next_question():

        q = current_student.quiz_questions[current_student.current_question]

        if answer_var.get() == q["answer"]:
            current_student.add_score()

        current_student.next_question()

        if current_student.current_question >= len(current_student.quiz_questions):

            save_highscore(current_student)

            quiz_window.destroy()

            return

        show_question()

    # Next button
    Button( quiz_window, text="NEXT", font=("Georgia", 10), width=15, command=next_question ).grid(row=7, column=0, pady=30)

    # Show the first question
    show_question()

#Set up validation checks to ensure that the user information is suitable and accurate - display the error window for invalid or boundary cases
def check_inputs():
    username = entry_username.get().strip()
    age = entry_age.get().strip()
    year_level = entry_year_level.get().strip()


#Username Validation check
    if username == "":
        error_window("Username cannot be blank.")
        return

    if not username.replace(" ", "").isalpha():
        error_window("Username must contain letters only.")
        return

#Age Validation
    
    if not age.isdigit():
        error_window("Age must be numeric.")
        return
    age = int(age)
    if age < 0 or age > 120:
        error_window("Age must be between 0 and 120.")
        return

#Year Level Validation
    if not year_level.isdigit():
        error_window("Year level must be numeric.")
        return
    year_level = int(year_level)
    if year_level < 1 or year_level > 13:
        error_window("Year level must be between 1 and 13.")
        return

#Combo Box Validation check
    if combo_difficulty.get() not in ["ADVANCED", "BASIC", "EXPERT",
                                      "advanced", "basic", "expert",
                                      "Advanced", "Basic", "Expert", ]:
        error_window("Please select a difficulty option.")
        return


#Create the Student Object for the Student Class
    global current_student
    
    current_student = Student( username, age, year_level )
    start_quiz()

