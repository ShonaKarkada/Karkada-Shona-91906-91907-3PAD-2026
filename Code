#Define the error_window to be displayed when an incorrect input is identified
def error_window(message):
    error = tk.Toplevel(main_window)
    error.title("Input Error")
    error.geometry("300x120")
    error.configure(bg="#dfd5ed")

    Label(error, text=message, fg="red", bg="#dfd5ed", font= ("Georgia", 10)).pack(pady=20)

    Button(error, text="OK", command=error.destroy, width=10).pack()

#Define the function to be carried out when the finish button is pressed
def save_highscore(student): 
    with open(HIGHSCORE_FILE, "a") as file:
        file.write(f"{student.username} - {student.score}\n")

#Define the view_highscores button on the main window
def view_highscores():
    highscore_window = tk.Toplevel(main_window)
    highscore_window.title("Highscores Window")
    highscore_window.geometry("350x350")
    highscore_window.configure(bg="#dfd5ed")

#Format the layout for the highscore window
    Label(highscore_window, text="HIGHSCORES", font=("Georgia", 10), bg="#cfc1e3").pack(pady=10)

    try:

        with open(HIGHSCORE_FILE, "r") as file:

            scores = file.readlines()

            if len(scores) == 0:

                Label( highscore_window, text="No highscores yet", bg="#dfd5ed").pack()
                Button(highscore_window, text="Close", command=highscore_window.destroy, width=10).pack()

            else:

                for score in scores:

                    Label( highscore_window, text=score.strip(), bg="#dfd5ed", font=("Georgia", 10)).pack()
            Button(highscore_window, text="Close", command=highscore_window.destroy, width=10).pack()

    except FileNotFoundError:
        Label( highscore_window, text="No highscores found.", bg="#dfd5ed").pack()
        Button(highscore_window, text="Close", command=highscore_window.destroy, width=10).pack()
        
